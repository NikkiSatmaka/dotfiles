# Prefer Homebrew Zsh; chezmoi resolves the path when applying shell.conf.
{{- $zsh := "/bin/zsh" }}
{{- $candidates := list }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $candidates = list "/opt/homebrew/bin/zsh" "/usr/local/bin/zsh" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $candidates = list "/home/linuxbrew/.linuxbrew/bin/zsh" (joinPath .chezmoi.homeDir ".linuxbrew/bin/zsh") }}
{{- end }}
{{- range $candidate := $candidates }}
{{-   if eq $zsh "/bin/zsh" }}
{{-     with stat $candidate }}
{{-       if not .isDir }}
{{-         $zsh = $candidate }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
set -g default-shell {{ $zsh | quote }}
